PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster/database
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash
EMAIL_USER=mailer@example.com
EMAIL_PASS=app-password
CLOUDINARY_CLOUD_NAME=cloud-name
CLOUDINARY_API_KEY=api-key
CLOUDINARY_API_SECRET=api-secret
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-dedicated-webhook-secret
# Keep INR until Razorpay has approved international payments for this account.
# Add USD,EUR,GBP only after approval and a successful test transaction in each.
PAYMENT_ALLOWED_CURRENCIES=INR
CORS_ORIGIN=http://localhost:3000
BASE_CURRENCY=INR
# Optional: endpoint for the exchange-rate provider used by the application.
EXCHANGE_RATE_API_URL=
