            )
            .filter(Boolean),

        documents:
          safeArray(
            productForm.documents
          )
            .map((document) => ({
              name:
                String(
                  document.name ||
                    ''
                ).trim(),

              url:
                String(
                  document.url ||
                    ''
                ).trim(),

              type:
                String(
                  document.type ||
                    ''
                ).trim()
            }))
            .filter(
              (document) =>
                document.url
            ),

        seo: {
          title:
            String(
              productForm.seo
                ?.title || ''
            ).trim(),

          description:
            String(
              productForm.seo
                ?.description ||
                ''
            ).trim(),

          keywords:
            String(
              productForm.seo
                ?.keywords || ''
            ).trim(),

          slug:
            String(
              productForm.seo
                ?.slug || ''
            )
              .trim()
              .toLowerCase()
        },

        relatedProducts:
          safeArray(
            productForm.relatedProducts
          ),

        metadata
      };

      return payload;
    };

  /*
   * =========================================================
   * ADD PRODUCT
   * =========================================================
   */

  const handleAddProduct = async (
    event
  ) => {
    event.preventDefault();

    if (
      !productForm.sku.trim()
    ) {
      alert(
        'SKU is required.'
      );

      return;
    }

    if (
      !productForm.name.trim()
    ) {
      alert(
        'Product name is required.'
      );

      return;
    }

    try {
      setSaving(true);

      const payload =
        normalizeProductPayload();

      await api.post(
        `${API_BASE_URL}/products`,
        payload,
        getAuthConfig()
      );

      alert(
        'Product created successfully.'
      );

      resetProduct();

      await fetchProducts();

      setActiveTab('products');
    } catch (error) {
      console.error(
        'Create product error:',
        error
      );

      alert(
        error.response?.data?.message ||
          error.message ||
          'Unable to create product.'
      );
    } finally {
      setSaving(false);
    }
  };

  /*
   * =========================================================
   * EDIT PRODUCT
   * =========================================================
   */

  const handleEditProduct = (
    product
  ) => {
    setEditingProduct(product);

    const normalized = {
      ...clone(EMPTY_PRODUCT),
      ...product,

      categoryId:
        product.categoryId?._id ||
        product.categoryId ||
        '',

      subcategoryId:
        product.subcategoryId?._id ||
        product.subcategoryId ||
        '',

      currencyPrices:
        product.currencyPrices
          ? {
              ...(typeof product
                .currencyPrices
                .toObject ===
              'function'
                ? product.currencyPrices.toObject()
                : product.currencyPrices)
            }
          : {},

      currencyPricing:
        product.currencyPricing
          ? Object.fromEntries(
              Object.entries(
                typeof product.currencyPricing.toObject === 'function'
                  ? product.currencyPricing.toObject()
                  : product.currencyPricing
              ).map(([code, config]) => [
                String(code).toUpperCase(),
                {
                  ...clone(EMPTY_CURRENCY_PRICING),
                  ...(config || {}),
                  overridePrice:
                    config?.overridePrice ??
                    config?.price ??
                    ''
                }
              ])
            )
          : {},

      pricing: {
        ...clone(
          EMPTY_PRODUCT.pricing
        ),
        ...(product.pricing || {}),

        quantityTiers:
          safeArray(
            product.pricing
              ?.quantityTiers
          ).map(
            (tier) => ({
              ...clone(
                EMPTY_TIER
              ),
              ...tier
            })
          )
      },

      specifications:
        safeArray(
          product.specifications
        ).map(
          (spec) => ({
            name:
              spec.name || '',
            value:
              spec.value || ''
          })
        ),

      variants:
        safeArray(
          product.variants
        ).map(
          (variant) => ({
            ...clone(
              EMPTY_VARIANT
            ),
            ...variant,
            attributes:
              variant.attributes ||
              {}
          })
        ),

      images:
        safeArray(
          product.images
        ).map(
          (image) => ({
            ...clone(
              EMPTY_IMAGE
            ),
            ...image
          })
        ),

      features:
        safeArray(
          product.features
        ),

      applications:
        safeArray(
          product.applications
        ),

      documents:
        safeArray(
          product.documents
        ),

      seo: {
        ...clone(
          EMPTY_PRODUCT.seo
        ),
        ...(product.seo || {})
      },

      relatedProducts:
        safeArray(
          product.relatedProducts
        ).map(
          (item) =>
            item?._id ||
            item
        ),

      metadata:
        product.metadata ||
        {}
    };

    setProductForm(
      normalized
    );

    setMetadataText(
      JSON.stringify(
        product.metadata ||
          {},
        null,
        2
      )
    );

    setActiveTab(
      'add-product'
    );

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  };

  /*
   * =========================================================
   * UPDATE PRODUCT
   * =========================================================
   */

  const handleUpdateProduct =
    async (event) => {
      event.preventDefault();

      if (
        !editingProduct?._id
