                          <strong>
                            {formatMoney(
                              selectedOrder.totalAmount
                            )}
                          </strong>
                          . After a successful refund,
                          inventory will be restored.
                        </p>

                        <p className="text-xs text-pink-600 mt-2">
                          Payment ID:{' '}
                          {selectedOrder.payment
                            ?.razorpayPaymentId ||
                            'Missing'}
                        </p>

                        <div className="flex justify-end gap-2 mt-3">

                          <button
                            onClick={() =>
                              setShowRefundBox(
                                false
                              )
                            }
                            disabled={saving}
                            className="px-4 py-2 rounded-lg bg-white border border-slate-200 text-sm font-semibold"
                          >
                            Back
                          </button>

                          <button
                            onClick={
                              confirmRefund
                            }
                            disabled={
                              saving
                            }
                            className="px-4 py-2 rounded-lg bg-pink-600 hover:bg-pink-700 text-white text-sm font-semibold disabled:opacity-50"
                          >
                            {saving
                              ? 'Processing Refund...'
                              : 'Confirm Refund'}
                          </button>

                        </div>

                      </div>

                    </div>

                  </div>
                )}

                {/* ACTION BUTTONS */}

                <div className="flex flex-wrap justify-end gap-3 mt-5">

                  <button
                    onClick={closeOrder}
                    disabled={saving}
                    className="px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-700"
                  >
                    Close
                  </button>

                  <button
                    onClick={saveOrder}
                    disabled={
                      saving ||
                      !editForm.status
                    }
                    className="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold disabled:opacity-50"
                  >
                    {saving
                      ? 'Saving...'
                      : editForm.status ===
                        'Cancelled'
                      ? 'Continue Cancellation'
                      : editForm.status ===
                        'Refunded'
                      ? 'Continue Refund'
                      : 'Save Order'}
                  </button>

                </div>

              </div>

            </div>
          </div>
        </div>
      )}

    </div>
  );
};

const AddressBlock = ({
  address
}) => {
  if (!address) {
    return (
      <div className="text-sm text-slate-500">
        No address available.
      </div>
    );
  }

  return (
    <div className="text-sm text-slate-600 leading-6">

      <div className="font-semibold text-slate-900">
        {address.fullName}
      </div>

      {address.company && (
        <div>
          {address.company}
        </div>
      )}

      <div>
        {address.addressLine1}
      </div>

      {address.addressLine2 && (
        <div>
          {address.addressLine2}
        </div>
      )}

      <div>
        {address.city},{' '}
        {address.state} -{' '}
        {address.postalCode}
      </div>

      <div>
        {address.country}
      </div>

      {address.phone && (
        <div className="mt-1">
          Phone: {address.phone}
        </div>
      )}

    </div>
  );
};

export default AdminOrders;
