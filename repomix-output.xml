            </section>

            <section className="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
              <label className="flex items-center gap-3 cursor-pointer mb-6">
                <input
                  type="checkbox"
                  checked={
                    sameBilling
                  }
                  onChange={(e) =>
                    setSameBilling(
                      e.target.checked
                    )
                  }
                  className="w-4 h-4 accent-blue-600"
                />

                <span className="text-sm font-semibold text-slate-700">
                  Billing address is same as shipping address
                </span>
              </label>

              {!sameBilling && (
                <AddressFields
                  address={
                    billingAddress
                  }
                  updateAddress={
                    updateBilling
                  }
                />
              )}
            </section>

            <section className="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
              <label className="block text-sm font-semibold text-slate-700 mb-2">
                Order Notes
              </label>

              <textarea
                value={
                  customerNote
                }
                onChange={(e) =>
                  setCustomerNote(
                    e.target.value
                  )
                }
                rows={4}
                placeholder="Any delivery or product instructions..."
                className="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
              />
            </section>
          </div>

          <aside className="xl:sticky xl:top-24 h-fit">
            <section className="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
              <h2 className="font-bold text-xl text-slate-900 mb-5">
                Order Summary
              </h2>

              <div className="space-y-4">
                {cart.map(
                  (item) => (
                    <div
                      key={
                        item._id
                      }
                      className="flex gap-3"
                    >
                      <div className="w-14 h-14 bg-slate-100 rounded-lg overflow-hidden flex-shrink-0">
                        {item.imageUrl ? (
                          <img
                            src={
                              item.imageUrl
                            }
                            alt={
                              item.name
                            }
                            className="w-full h-full object-cover"
                          />
                        ) : null}
                      </div>

                      <div className="flex-1 min-w-0">
                        <p className="font-semibold text-sm text-slate-800">
                          {
                            item.name
                          }
                        </p>

                        <p className="text-xs text-slate-500 mt-1">
                          Qty:{' '}
                          {
                            item.quantity
                          }
                        </p>
                      </div>

                      <div className="text-right">
                        <p className="text-sm font-bold text-slate-800">
                          {currencySymbol}
                          {(
                            getItemUnitPrice(
                              item,
                              selectedCurrency
                            ).amount *
                            Number(item.quantity || 0)
                          ).toLocaleString('en-IN', {
                            maximumFractionDigits: 2
                          })}
                        </p>

                        {!getItemUnitPrice(
                          item,
                          selectedCurrency
                        ).available && (
                          <p className="text-[10px] text-amber-600 mt-0.5">
                            Not priced in {selectedCurrency},
                            showing {item.baseCurrency || 'INR'}
                          </p>
                        )}
                      </div>
                    </div>
                  )
                )}
              </div>

              {hasUnavailableItem && (
                <div className="mt-3 text-xs bg-amber-50 border border-amber-200 text-amber-700 rounded-lg px-3 py-2">
                  Some items in your cart aren't priced in{' '}
                  {selectedCurrency} yet. Amounts shown for those
                  items use their original currency instead.
                </div>
              )}

              <div className="border-t border-slate-200 my-5" />

              <div className="space-y-3 text-sm">
                <div className="flex justify-between">
                  <span className="text-slate-500">
                    Subtotal
                  </span>

                  <span className="font-semibold">
                    {currencySymbol}
                    {subtotal.toLocaleString('en-IN', {
                      maximumFractionDigits: 2
                    })}
                  </span>
                </div>

                <div className="flex justify-between">
                  <span className="text-slate-500">
                    GST
                  </span>

                  <span className="font-semibold">
                    {currencySymbol}
                    {taxAmount.toLocaleString('en-IN', {
                      maximumFractionDigits: 2
                    })}
                  </span>
                </div>

                <div className="flex justify-between">
                  <span className="text-slate-500">
                    Shipping
                  </span>

                  <span className="font-semibold text-emerald-600">
                    Calculated by team
                  </span>
                </div>
              </div>

              <div className="border-t border-slate-200 my-5" />

              <div className="flex justify-between items-center">
                <span className="text-lg font-bold text-slate-900">
                  Total
                </span>

                <span className="text-2xl font-extrabold text-blue-600">
                  {currencySymbol}
                  {total.toLocaleString('en-IN', {
                    maximumFractionDigits: 2
                  })}
                </span>
              </div>

              <button
                onClick={
                  handlePayment
                }
                disabled={
                  loading
                }
                className="mt-6 w-full bg-blue-600 hover:bg-blue-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold rounded-xl px-5 py-4 flex items-center justify-center gap-2 transition shadow-lg shadow-blue-600/20"
              >
                {loading ? (
                  <>
                    <Loader2
                      size={18}
                      className="animate-spin"
                    />
                    Processing...
                  </>
                ) : (
                  <>
                    <CreditCard size={18} />
                    Pay Securely
                  </>
                )}
              </button>

              <div className="mt-4 flex items-start gap-2 text-xs text-slate-500">
                <ShieldCheck
                  size={15}
                  className="text-emerald-500 flex-shrink-0"
                />

                <span>
                  Secure payment powered by Razorpay.
                  Your payment credentials are handled
                  by Razorpay Checkout.
                </span>
              </div>

              <div className="mt-4 flex items-center justify-center gap-2 text-xs text-slate-400">
                <CheckCircle2
                  size={14}
                />
                Order confirmation after successful payment
              </div>
            </section>
          </aside>
        </div>
      </div>
    </main>
  );
};

const Field = ({
  label,
  required = false,
  type = 'text',
  value,
  onChange
}) => (
  <label className="block">
    <span className="block text-sm font-semibold text-slate-700 mb-2">
      {label}

      {required && (
        <span className="text-rose-500">
          {' '}*
        </span>
      )}
    </span>

    <input
      type={type}
      value={value}
      onChange={(e) =>
        onChange(
          e.target.value
        )
      }
      className="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
    />
  </label>
);

const AddressFields = ({
  address,
  updateAddress
}) => (
  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
    <Field
      label="Full Name"
      required
      value={
        address.fullName
      }
      onChange={(value) =>
        updateAddress(
          'fullName',
          value
        )
      }
    />

    <Field
      label="Company"
      value={
        address.company
      }
      onChange={(value) =>
        updateAddress(
          'company',
          value
        )
      }
    />

    <div className="md:col-span-2">
      <Field
        label="Address Line 1"
        required
        value={
          address.addressLine1
        }
        onChange={(value) =>
          updateAddress(
            'addressLine1',
            value
          )
        }
      />
    </div>

    <div className="md:col-span-2">
      <Field
        label="Address Line 2"
        value={
          address.addressLine2
        }
        onChange={(value) =>
          updateAddress(
            'addressLine2',
            value
          )
        }
      />
    </div>

    <Field
      label="City"
      required
      value={
        address.city
      }
      onChange={(value) =>
        updateAddress(
          'city',
          value
        )
      }
    />

    <Field
      label="State"
      required
      value={
        address.state
      }
      onChange={(value) =>
        updateAddress(
          'state',
          value
        )
      }
    />

    <Field
      label="Postal Code"
      required
      value={
        address.postalCode
      }
      onChange={(value) =>
        updateAddress(
          'postalCode',
          value
        )
      }
    />

    <Field
      label="Country"
      required
      value={
        address.country
      }
      onChange={(value) =>
        updateAddress(
          'country',
          value
        )
      }
    />
  </div>
);

export default CheckoutPage;
</file>

