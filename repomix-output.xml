import React, {
  useEffect,
  useMemo,
  useState
} from 'react';

import {
  Link,
  useNavigate
} from 'react-router-dom';

import {
  ArrowRight,
  Minus,
  Plus,
  ShoppingCart,
  Trash2,
  RefreshCw
} from 'lucide-react';

import api from '../lib/api';

const readCart = () => {
  try {
    return JSON.parse(
      localStorage.getItem('cart') || '[]'
    );
  } catch {
    return [];
  }
};

const CartPage = () => {
  const navigate = useNavigate();

  const [cart, setCart] =
    useState(readCart);

  const [refreshing, setRefreshing] =
    useState(true);

  const [error, setError] =
    useState('');

  const saveCart = (items) => {
    setCart(items);

    localStorage.setItem(
      'cart',
      JSON.stringify(items)
    );

    window.dispatchEvent(
      new Event('cartUpdated')
    );
  };

  /*
   * Always refresh products from DB.
   *
   * This fixes:
   * - old price
   * - old stock
   * - deleted product
   * - changed MOQ
   */
  useEffect(() => {
    const refreshCart = async () => {
      const existingCart =
        readCart();

      if (!existingCart.length) {
        setCart([]);
        setRefreshing(false);
        return;
      }

      try {
        setError('');

        const response =
          await api.get('/products');

        const products =
          response.data || [];

        const productMap =
          new Map(
            products.map((product) => [
              product._id,
              product
            ])
          );

        const updatedCart = [];

        for (
          const oldItem of existingCart
        ) {
          const current =
            productMap.get(
              oldItem._id
            );

          /*
           * Product deleted/deactivated.
           */
          if (!current) {
            continue;
          }

          const moq =
            Number(current.moq) || 1;

          const stock =
            Number(current.stock) || 0;

          let quantity =
            Number(
              oldItem.quantity
            ) || moq;

          /*
           * If stock is zero, don't keep
           * an impossible cart item.
           */
          if (stock <= 0) {
            continue;
          }

          quantity = Math.max(
            moq,
            quantity
          );

          quantity = Math.min(
            quantity,
            stock
          );

          updatedCart.push({
            ...current,
            quantity
          });
        }

        saveCart(updatedCart);
      } catch (err) {
        console.error(
          'Cart refresh error:',
          err
        );

        setError(
          'Unable to refresh your cart. Please try again.'
        );
      } finally {
        setRefreshing(false);
      }
    };

    refreshCart();
  }, []);

  const total = useMemo(
    () =>
      cart.reduce(
        (sum, item) =>
          sum +
          (Number(item.price) || 0) *
            Number(item.quantity || 0),
        0
      ),
    [cart]
  );

  const setQuantity = (
    id,
    quantity
  ) => {
    const item =
      cart.find(
        (product) =>
          product._id === id
      );

    if (!item) return;

    const moq =
      Number(item.moq) || 1;

    const stock =
      Number(item.stock) || 0;

    let nextQuantity =
      Number(quantity);

    if (!Number.isFinite(nextQuantity)) {
      nextQuantity = moq;
    }

    nextQuantity =
      Math.max(
        moq,
        nextQuantity
      );

    nextQuantity =
      Math.min(
        stock,
        nextQuantity
      );

    saveCart(
      cart.map((product) =>
        product._id === id
          ? {
              ...product,
              quantity:
                nextQuantity
            }
          : product
      )
    );
  };

  const removeItem = (id) => {
    saveCart(
      cart.filter(
        (item) =>
          item._id !== id
      )
    );
  };

  if (refreshing) {
    return (
      <main className="min-h-screen bg-slate-50 flex items-center justify-center">
        <div className="flex items-center gap-3 text-slate-500">
          <RefreshCw
            size={20}
            className="animate-spin"
          />
          Refreshing inventory...
        </div>
      </main>
    );
  }

  if (!cart.length) {
    return (
      <main className="min-h-screen bg-slate-50 px-6 py-16 text-center">
        <ShoppingCart
          className="mx-auto text-slate-400"
          size={52}
        />

        <h1 className="mt-5 text-2xl font-extrabold text-slate-900">
          Your cart is empty
        </h1>

        <p className="mt-2 text-slate-500">
          Products may have become unavailable or
          your cart is empty.
        </p>

        <Link
          to="/"
          className="mt-6 inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-3 rounded-xl"
        >
          Browse Products
          <ArrowRight size={17} />
        </Link>
      </main>
    );
  }

  return (
