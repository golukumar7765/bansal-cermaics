  const normalizeProductPayload =
    () => {
      let metadata = {};

      try {
        metadata =
          metadataText.trim()
            ? JSON.parse(
                metadataText
              )
            : {};
      } catch {
        throw new Error(
          'Metadata must contain valid JSON.'
        );
      }

      const currencyPrices =
        Object.entries(
          productForm.currencyPrices ||
            {}
        ).reduce(
          (
            result,
            [code, value]
          ) => {
            if (
              value !== '' &&
              value !== null &&
              value !== undefined
            ) {
              const number =
                Number(value);

              if (
                Number.isFinite(
                  number
                )
              ) {
                result[
                  code
                    .toUpperCase()
                ] = number;
              }
            }

            return result;
          },
          {}
        );

      const currencyPricing =
        Object.entries(productForm.currencyPricing || {}).reduce(
          (result, [code, config]) => {
            const normalizedCode = String(code).trim().toUpperCase();
            const mode = ['auto', 'multiplier', 'override'].includes(config?.mode)
              ? config.mode
              : 'auto';
            const multiplier = Number(config?.multiplier);
            const overridePrice = Number(
              config?.overridePrice ??
              config?.price
            );
            result[normalizedCode] = {
              mode,
              multiplier:
                Number.isFinite(multiplier) && multiplier >= 0
                  ? multiplier
                  : 1,
              overridePrice:
                Number.isFinite(overridePrice) && overridePrice >= 0
                  ? overridePrice
                  : null,
              enabled:
                config?.enabled !== false
            };
            return result;
          },
          {}
        );

      const payload = {
        ...productForm,

        sku:
          String(
            productForm.sku ||
              ''
          )
            .trim()
            .toUpperCase(),

        name:
          String(
            productForm.name ||
              ''
          ).trim(),

        categoryId:
          productForm.categoryId ||
          null,

        subcategoryId:
          productForm.subcategoryId ||
          null,

        category:
          productForm.category ||
          '',

        subcategory:
          productForm.subcategory ||
          '',

        price:
          numberOrZero(
            productForm.price
          ),

        baseCurrency:
          String(
            productForm.baseCurrency ||
              'INR'
          )
            .trim()
            .toUpperCase(),

        currencyPrices,

        currencyPricing,

        pricing: {
          pricingMode:
            productForm.pricing
              ?.pricingMode ||
            'base',

          allowCurrencyConversion:
            productForm.pricing
              ?.allowCurrencyConversion !==
            false,

          allowQuantityPricing:
            Boolean(
              productForm.pricing
                ?.allowQuantityPricing
            ),

          quantityTiers:
            safeArray(
              productForm.pricing
                ?.quantityTiers
            )
              .map(
                (tier) => ({
                  minQuantity:
                    integerOr(
                      tier.minQuantity,
                      1
                    ),

                  maxQuantity:
                    tier.maxQuantity ===
                      '' ||
                    tier.maxQuantity ===
                      null ||
                    tier.maxQuantity ===
                      undefined
                      ? null
                      : integerOr(
                          tier.maxQuantity,
                          null
                        ),

                  price:
                    numberOrZero(
                      tier.price
                    ),

                  currency:
                    String(
                      tier.currency ||
                        productForm.baseCurrency ||
                        'INR'
                    )
                      .trim()
                      .toUpperCase()
                })
              )
              .filter(
                (tier) =>
                  tier.minQuantity >
                    0 &&
                  tier.price >= 0
              )
        },

        moq:
          Math.max(
            1,
            integerOr(
              productForm.moq,
              1
            )
          ),

        stock:
          Math.max(
            0,
            numberOrZero(
              productForm.stock
            )
          ),

        specifications:
          safeArray(
            productForm.specifications
          )
            .map(
              (spec) => ({
                name:
                  String(
                    spec.name || ''
                  ).trim(),

                value:
