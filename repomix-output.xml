        alert(
          'No product selected.'
        );

        return;
      }

      try {
        setSaving(true);

        const payload =
          normalizeProductPayload();

        await api.put(
          `${API_BASE_URL}/products/${editingProduct._id}`,
          payload,
          getAuthConfig()
        );

        alert(
          'Product updated successfully.'
        );

        resetProduct();

        await fetchProducts();

        setActiveTab('products');
      } catch (error) {
        console.error(
          'Update product error:',
          error
        );

        alert(
          error.response?.data
            ?.message ||
            error.message ||
            'Unable to update product.'
        );
      } finally {
        setSaving(false);
      }
    };

  /*
   * =========================================================
   * DELETE PRODUCT
   * =========================================================
   */

  const handleDeleteProduct = async (
    id
  ) => {
    if (
      !window.confirm(
        'Delete/archive this product?'
