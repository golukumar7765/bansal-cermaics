    try {
      setLoading(true);

      const res = await api.get(
        `${API_BASE_URL}/products?includeArchived=true&limit=100`
      );

      setProducts(
        Array.isArray(res.data)
          ? res.data
          : res.data?.data || []
      );
    } catch (error) {
      console.error(
        'Fetch products error:',
        error
      );
    } finally {
      setLoading(false);
    }
  };

