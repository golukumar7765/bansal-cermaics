<file path="frontend/src/pages/CheckoutPage.jsx">
import React, {
  useEffect,
  useMemo,
  useState
} from 'react';

import {
  Link,
  useNavigate
} from 'react-router-dom';

import {
  ArrowLeft,
  CheckCircle2,
  CreditCard,
  Loader2,
  MapPin,
  ShieldCheck,
  ShoppingBag
} from 'lucide-react';

import api, {
  getApiError
} from '../lib/api';

const readCart = () => {
  try {
    return JSON.parse(
      localStorage.getItem('cart') || '[]'
    );
  } catch {
    return [];
  }
};

const emptyAddress = {
  fullName: '',
  company: '',
  addressLine1: '',
  addressLine2: '',
  city: '',
  state: '',
  postalCode: '',
  country: 'India'
};

const CheckoutPage = () => {
  const navigate =
    useNavigate();

  const [cart, setCart] =
    useState(readCart);

  const [selectedCurrency, setSelectedCurrency] = useState(
    localStorage.getItem('selectedCurrency') || 'INR'
  );

  const [availableCurrencies, setAvailableCurrencies] = useState([
    { code: 'INR', name: 'Indian Rupee', symbol: '\u20b9' }
  ]);

  const [isCurrencyOpen, setIsCurrencyOpen] = useState(false);

  // =========================================================
  // CURRENCY (same source of truth as Navbar/HomePage/ProductDetailPage)
  // =========================================================

  useEffect(() => {
    const fetchCurrencies = async () => {
      try {
        const res = await api.get('/currencies');
        const list = Array.isArray(res.data)
          ? res.data
          : res.data?.data || [];

        const active = list.filter((c) => c.isActive !== false);

        if (active.length > 0) {
          setAvailableCurrencies(active);
        }
      } catch (error) {
        console.warn(
          'Currency API unavailable, defaulting to INR only:',
          error?.response?.data || error?.message
        );
      }
    };

    fetchCurrencies();

    const updateCurrency = () => {
      setSelectedCurrency(
        localStorage.getItem('selectedCurrency') || 'INR'
      );
    };

    window.addEventListener('currencyChanged', updateCurrency);
    window.addEventListener('storage', updateCurrency);

    return () => {
      window.removeEventListener('currencyChanged', updateCurrency);
      window.removeEventListener('storage', updateCurrency);
    };
  }, []);

  const handleCurrencyChange = (code) => {
    localStorage.setItem('selectedCurrency', code);
    setSelectedCurrency(code);
    setIsCurrencyOpen(false);
    window.dispatchEvent(new Event('currencyChanged'));
  };

  const [customer, setCustomer] =
    useState({
      name: '',
      email: '',
      phone: '',
      company: '',
      gstin: ''
    });

  const [shippingAddress, setShippingAddress] =
    useState(emptyAddress);

  const [billingAddress, setBillingAddress] =
    useState(emptyAddress);

  const [sameBilling, setSameBilling] =
    useState(true);

  const [customerNote, setCustomerNote] =
    useState('');

  const [loading, setLoading] =
    useState(false);

  const [refreshing, setRefreshing] =
    useState(true);

  const [error, setError] =
    useState('');

  /*
   * Refresh cart against DB.
   */
  useEffect(() => {
    const refresh = async () => {
      const oldCart =
        readCart();

      if (!oldCart.length) {
        navigate('/cart', {
          replace: true
        });
        return;
      }

      try {
        const response =
          await api.get(
            '/products'
          );

        const products =
          response.data || [];

        const productMap =
          new Map(
            products.map(
              (product) => [
                product._id,
                product
              ]
            )
          );

        const freshCart = [];

        for (
          const item of oldCart
        ) {
          const product =
            productMap.get(
              item._id
            );

          if (!product) {
            continue;
          }

          const stock =
            Number(product.stock) || 0;

          const moq =
            Number(product.moq) || 1;

          if (stock < moq) {
            continue;
          }

          let quantity =
            Number(
              item.quantity
            ) || moq;

          quantity =
            Math.max(
              moq,
              quantity
            );

          quantity =
            Math.min(
              stock,
              quantity
            );

          freshCart.push({
            ...product,
            quantity
          });
        }

        if (!freshCart.length) {
          localStorage.removeItem(
            'cart'
          );

          setCart([]);

          navigate('/cart', {
            replace: true
          });

          return;
        }

        setCart(freshCart);

        localStorage.setItem(
          'cart',
          JSON.stringify(
            freshCart
          )
        );
      } catch (err) {
        console.error(
          'Checkout cart refresh:',
          err
        );

        setError(
          'Unable to refresh inventory. Please go back to cart and try again.'
        );
      } finally {
        setRefreshing(false);
      }
    };

    refresh();
  }, [navigate]);

  /*
   * Resolve each cart item's unit price for the CURRENTLY selected
   * currency (not whatever currency it happened to be added in).
   * Falls back to the item's own displayedUnitPrice/base price if
   * the product has no price configured for this currency.
   */
  const getItemUnitPrice = (item, currency) => {
    const baseCurrency = String(
      item.baseCurrency || 'INR'
    ).toUpperCase();

    const code = String(currency || 'INR').toUpperCase();

    if (code === baseCurrency) {
      return {
        amount: Number(item.price) || 0,
        available: true
      };
    }

    const match = Array.isArray(item.prices)
      ? item.prices.find(
          (p) =>
            String(p.currency).toUpperCase() === code &&
            p.enabled !== false
        )
      : null;

    if (match && Number.isFinite(Number(match.price))) {
      return {
        amount: Number(match.price),
        available: true
      };
    }

    // Not configured for this currency — fall back to base price,
    // but flag it so the UI can warn the customer.
    return {
      amount: Number(item.price) || 0,
      available: false
    };
  };

  const currencySymbol =
    availableCurrencies.find(
      (c) => c.code === selectedCurrency
    )?.symbol || selectedCurrency;

  const hasUnavailableItem =
    useMemo(
      () =>
        cart.some(
          (item) =>
            !getItemUnitPrice(item, selectedCurrency).available
        ),
      [cart, selectedCurrency]
    );

  const subtotal =
    useMemo(
      () =>
        cart.reduce((sum, item) => {
          const { amount } = getItemUnitPrice(
            item,
            selectedCurrency
          );

          return (
            sum +
            amount * Number(item.quantity || 0)
          );
        }, 0),
      [cart, selectedCurrency]
    );

  const taxRate = 0;

  const taxAmount =
    useMemo(
      () =>
        subtotal *
        (taxRate / 100),
      [subtotal]
    );

  const total =
    subtotal + taxAmount;

  const updateCustomer = (
    field,
    value
  ) => {
    setCustomer((prev) => ({
      ...prev,
      [field]: value
    }));
  };

  const updateShipping = (
    field,
    value
  ) => {
    setShippingAddress(
      (prev) => ({
        ...prev,
        [field]: value
      })
    );
  };

  const updateBilling = (
    field,
    value
  ) => {
    setBillingAddress(
      (prev) => ({
        ...prev,
        [field]: value
      })
    );
  };

  const loadRazorpayScript =
    () =>
      new Promise(
        (resolve) => {
          if (
            window.Razorpay
          ) {
            resolve(true);
            return;
          }

          const script =
            document.createElement(
              'script'
            );

          script.src =
            'https://checkout.razorpay.com/v1/checkout.js';

          script.onload = () =>
            resolve(true);

          script.onerror = () =>
            resolve(false);

          document.body.appendChild(
            script
          );
        }
      );

  const validateForm = () => {
    if (
      !customer.name.trim()
    ) {
      return 'Please enter your name.';
    }

    if (
      !customer.email.trim() ||
      !/^\S+@\S+\.\S+$/.test(
        customer.email.trim()
      )
    ) {
      return 'Please enter a valid email address.';
    }

    if (
      !customer.phone.trim()
    ) {
      return 'Please enter your phone number.';
    }

    const requiredAddressFields = [
      ['fullName', 'Full name'],
      [
        'addressLine1',
        'Address'
      ],
      ['city', 'City'],
      ['state', 'State'],
      [
        'postalCode',
        'Postal code'
      ],
      ['country', 'Country']
    ];

    for (
      const [
        field,
        label
      ] of requiredAddressFields
    ) {
      if (
        !shippingAddress[
          field
        ]?.trim()
      ) {
        return `Please enter ${label.toLowerCase()} in shipping address.`;
      }
    }

    if (!sameBilling) {
      for (
        const [
          field,
          label
        ] of requiredAddressFields
      ) {
        if (
          !billingAddress[
            field
          ]?.trim()
        ) {
          return `Please enter ${label.toLowerCase()} in billing address.`;
        }
      }
    }

    return '';
  };

  const handlePayment =
    async () => {
      setError('');

      const validationError =
        validateForm();

      if (validationError) {
        setError(
          validationError
        );

        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });

        return;
      }

      if (!cart.length) {
        setError(
          'Your cart is empty.'
        );
        return;
      }

      setLoading(true);

      try {
        const scriptLoaded =
          await loadRazorpayScript();

        if (!scriptLoaded) {
          throw new Error(
            'Unable to load Razorpay Checkout. Please check your internet connection.'
          );
        }

        /*
         * NEVER send price.
         * Backend gets price from MongoDB, resolved for
         * `selectedCurrency` (component state, kept in sync
         * with Navbar/HomePage/ProductDetailPage via
         * localStorage + the 'currencyChanged' event).
         */
        const payload = {
          items: cart.map(
            (item) => ({
              productId:
                item._id,
              quantity:
                Number(
                  item.quantity
                )
            })
          ),

          customer,

          shippingAddress,

          billingAddress:
            sameBilling
              ? {
                  ...shippingAddress
                }
              : billingAddress,

          customerNote,

          currency: selectedCurrency
        };

        const createResponse =
          await api.post(
            '/payment/create-order',
            payload
          );

        const data =
          createResponse.data;

        if (!data?.success) {
          throw new Error(
            data?.message ||
              'Unable to create payment order.'
          );
        }

        const razorpayOrder =
          data.razorpayOrder;

        const options = {
          key: data.keyId,

          amount:
            razorpayOrder.amount,

          currency:
            razorpayOrder.currency,

          name:
            'Bansal Scientific',

          description:
            `Order ${data.order.orderNumber}`,

          order_id:
            razorpayOrder.id,

          prefill: {
            name:
              customer.name,

            email:
              customer.email,

            contact:
              customer.phone
          },

          notes: {
            orderNumber:
              data.order.orderNumber
          },

          theme: {
            color:
              '#2563eb'
          },

          modal: {
            confirm_close: true,
            backdropclose: false
          },

          handler:
            async (
              response
            ) => {
              try {
                setLoading(true);

                const verifyResponse =
                  await api.post(
                    '/payment/verify-payment',
                    {
                      localOrderId:
                        data.order.id,

                      razorpay_order_id:
                        response.razorpay_order_id,

                      razorpay_payment_id:
                        response.razorpay_payment_id,

                      razorpay_signature:
                        response.razorpay_signature
                    }
                  );

                const verification =
                  verifyResponse.data;

                if (
                  !verification.success
                ) {
                  throw new Error(
                    verification.message ||
                      'Payment verification failed.'
                  );
                }

                localStorage.setItem(
                  'lastOrder',
                  JSON.stringify(
                    verification.order
                  )
                );

                localStorage.removeItem(
                  'cart'
                );

                window.dispatchEvent(
                  new Event(
                    'cartUpdated'
                  )
                );

                navigate(
                  `/order-success?order=${encodeURIComponent(
                    verification.order
                      .orderNumber
                  )}`,
                  {
                    replace: true
                  }
                );
              } catch (
                verificationError
              ) {
                setError(
                  getApiError(
                    verificationError,
                    'Payment was completed but verification failed. Please contact Bansal Scientific with your payment ID.'
                  )
                );

                setLoading(false);
              }
            }
        };

        const razorpay =
          new window.Razorpay(
            options
          );

        razorpay.on(
  'payment.failed',
  async (response) => {
    console.error(
      'Razorpay payment failed:',
      response
    );

    try {
      await api.post(
        '/payment/cancel-order',
        {
          localOrderId:
            data.order.id
        }
      );
    } catch (cancelError) {
      console.error(
        'Unable to release reserved stock after payment failure:',
        cancelError
      );
    }

    setError(
      response.error?.description ||
        'Payment failed. Please try again.'
    );

    setLoading(false);
  }
);
razorpay.on(
  'modal.close',
  async () => {
    try {
      await api.post(
        '/payment/cancel-order',
        {
          localOrderId:
            data.order.id
        }
      );
    } catch (error) {
      console.error(
        'Unable to release inventory after checkout close:',
        error
      );
    }

    setLoading(false);
  }
);

        razorpay.open();

        setLoading(false);
      } catch (err) {
        console.error(
          'Checkout error:',
          err
        );

        setError(
          getApiError(
            err,
            'Unable to start checkout.'
          )
        );

        setLoading(false);
      }
    };

  if (
    refreshing ||
    !cart.length
  ) {
    return (
      <main className="min-h-screen bg-slate-50 flex items-center justify-center">
        <Loader2
          className="animate-spin text-blue-600"
          size={28}
        />
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-50 py-8 px-4 sm:px-6">
      <div className="max-w-7xl mx-auto">
        <Link
          to="/cart"
          className="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-blue-600 mb-6"
        >
          <ArrowLeft size={16} />
          Back to Cart
        </Link>

        <div className="mb-8 flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 className="text-3xl font-extrabold text-slate-900">
              Checkout
            </h1>

            <p className="mt-2 text-slate-500">
              Complete your details and securely pay
