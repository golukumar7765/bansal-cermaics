  const uploadImage = async (
    file
  ) => {
    if (!file) {
      return null;
    }

    if (
      !file.type.startsWith(
        'image/'
      )
    ) {
      alert(
        'Please select an image.'
      );

      return null;
    }

    if (
      file.size >
      10 * 1024 * 1024
    ) {
      alert(
        'Image must be smaller than 10 MB.'
      );

      return null;
    }

    try {
      setUploading(true);

      const formData =
        new FormData();

      formData.append(
        'image',
        file
      );

      const res =
        await api.post(
          `${API_BASE_URL}/products/upload`,
          formData,
          {
            headers: {
              ...getAuthConfig()
                .headers,

              'Content-Type':
                'multipart/form-data'
            }
          }
        );

      return (
        res.data?.imageUrl ||
        null
      );
    } catch (error) {
      console.error(
        'Upload error:',
        error
      );

      alert(
        error.response?.data
          ?.message ||
          'Image upload failed.'
      );

      return null;
    } finally {
      setUploading(false);
    }
  };

