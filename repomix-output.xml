const mongoose = require('mongoose');
const Product = require('../models/Product');

const RESERVATION_MINUTES = 15;

const reservationExpiry = () =>
  new Date(
    Date.now() +
      RESERVATION_MINUTES * 60 * 1000
  );

/*
|--------------------------------------------------------------------------
| NORMALIZE ITEMS
|--------------------------------------------------------------------------
*/

const normalizeItems = (items = []) => {
  const map = new Map();

  for (const item of items) {
    const productId = String(
      item.productId ||
        item.product ||
        ''
    );

    const quantity = Number(
      item.quantity
    );

    if (
      !mongoose.Types.ObjectId.isValid(
        productId
      )
    ) {
      throw new Error(
        'Invalid product ID.'
      );
    }

    if (
      !Number.isInteger(quantity) ||
      quantity < 1
    ) {
      throw new Error(
        'Invalid inventory quantity.'
      );
    }

    map.set(
      productId,
      (map.get(productId) || 0) +
        quantity
    );
  }

  return Array.from(
    map.entries()
  ).map(
    ([productId, quantity]) => ({
      productId,
      quantity
    })
  );
};

/*
|--------------------------------------------------------------------------
| RAW RESTORE
|--------------------------------------------------------------------------
|
| Used only when reservation succeeded but
| Order creation failed.
|
*/

const restoreReservedItems = async (
  items = [],
  session = null
) => {
  for (const item of items) {
    if (
      !item?.productId ||
      !Number.isInteger(
        Number(item.quantity)
      ) ||
      Number(item.quantity) < 1
    ) {
      continue;
    }

    const query =
      Product.findByIdAndUpdate(
        item.productId,
        {
          $inc: {
            stock: Number(
              item.quantity
            )
          }
        },
        {
          new: true
        }
      );

    if (session) {
      query.session(session);
    }

    await query.exec();
  }

  return true;
};

/*
|--------------------------------------------------------------------------
| RESERVE STOCK
|--------------------------------------------------------------------------
|
| Atomic:
|
| stock >= quantity
|       ↓
| stock -= quantity
|
*/

const reserveStock = async (
  items
) => {
  const normalized =
    normalizeItems(items);

  const reserved = [];

  try {
    for (const item of normalized) {
      const updated =
        await Product.findOneAndUpdate(
          {
            _id:
              item.productId,

            archived: {
              $ne: true
            },

            isDirectPurchaseAllowed:
              true,

            $expr: {
              $gte: [
                {
                  $ifNull: [
                    '$stock',
                    0
                  ]
                },
                item.quantity
              ]
            }
          },
          {
            $inc: {
              stock:
                -item.quantity
            }
          },
          {
            new: true
          }
        );

      if (!updated) {
        const product =
          await Product.findById(
            item.productId
          ).select(
            'name stock archived isDirectPurchaseAllowed'
          );

        if (!product) {
          throw new Error(
            `Product ${item.productId} was not found.`
          );
        }

        if (product.archived) {
          throw new Error(
            `"${product.name}" is no longer available.`
          );
        }

        if (
          product.isDirectPurchaseAllowed !==
          true
        ) {
          throw new Error(
            `"${product.name}" is available through Request Quote only.`
          );
        }

        const stock =
          Number(
            product.stock
          ) || 0;

        throw new Error(
          `"${product.name}" has only ${stock} unit(s) available.`
        );
      }

      reserved.push({
        productId:
          item.productId,

        quantity:
          item.quantity
      });
    }

    return {
      items: reserved,

      expiresAt:
        reservationExpiry()
    };
  } catch (error) {
    try {
      await restoreReservedItems(
        reserved
      );
    } catch (rollbackError) {
      console.error(
        'CRITICAL: Failed to rollback inventory reservation:',
        rollbackError
      );
    }

    throw error;
  }
};

/*
|--------------------------------------------------------------------------
| RELEASE RESERVATION
|--------------------------------------------------------------------------
|
| Reserved -> Released
|
| IMPORTANT:
| The state transition is atomic FIRST.
| Only the request that wins the race
| returns stock.
|
*/

const releaseReservation =
  async (order, session = null) => {
    if (!order?._id) {
      throw new Error(
        'Valid order is required.'
      );
    }

    const query =
      order.constructor.findOneAndUpdate(
        {
          _id: order._id,

          'inventoryReservation.status':
            'Reserved'
        },
        {
          $set: {
            'inventoryReservation.status':
              'Released',

            'inventoryReservation.releasedAt':
              new Date()
          }
        },
        {
          new: true
        }
      );

    if (session) {
      query.session(session);
    }

    const updatedOrder =
      await query.exec();

    if (!updatedOrder) {
      return false;
    }

    for (const item of
      updatedOrder.items || []) {
      const productQuery =
        Product.findByIdAndUpdate(
          item.product,
          {
            $inc: {
              stock:
                item.quantity
            }
          },
          {
            new: true
          }
        );

      if (session) {
        productQuery.session(
          session
        );
      }

      const product =
        await productQuery.exec();

      if (!product) {
        throw new Error(
          `Product not found while releasing stock: ${
            item.name ||
            item.sku ||
            item.product
          }`
        );
      }
    }

    return true;
  };

/*
|--------------------------------------------------------------------------
| CONSUME RESERVATION
|--------------------------------------------------------------------------
|
| Reserved -> Consumed
|
| NO stock change here.
|
| Stock was already deducted when reservation
| was created.
|
*/

const consumeReservation =
  async (
    order,
    session = null
  ) => {
    if (!order?._id) {
      return false;
    }

    const query =
      order.constructor.findOneAndUpdate(
        {
          _id: order._id,

          'inventoryReservation.status':
            'Reserved'
        },
        {
          $set: {
            'inventoryReservation.status':
              'Consumed',

            'inventoryReservation.consumedAt':
              new Date()
          }
        },
        {
          new: true
        }
      );

    if (session) {
      query.session(session);
    }

    const updated =
      await query.exec();

    if (!updated) {
      return false;
    }

    order.inventoryReservation =
      updated.inventoryReservation;

    return true;
  };

/*
|--------------------------------------------------------------------------
| RESTORE PAID ORDER STOCK
|--------------------------------------------------------------------------
|
| Paid
|  ↓
| Cancel / Refund
|  ↓
| Restore stock
|
| Atomic claim prevents double restoration.
|
*/

const restoreOrderStock =
  async (
    order,
    session = null
  ) => {
    if (!order?._id) {
      throw new Error(
        'Valid order is required.'
      );
    }

    if (
      order.payment?.status !==
      'Paid'
    ) {
      return false;
    }

    const claimQuery =
      order.constructor.findOneAndUpdate(
        {
          _id: order._id,

          inventoryRestored: {
            $ne: true
          },

          'payment.status':
            'Paid'
        },
        {
          $set: {
            inventoryRestored:
              true,

            'inventoryReservation.status':
              'Restored',

            'inventoryReservation.restoredAt':
              new Date()
          }
        },
        {
          new: true
        }
      );

    if (session) {
      claimQuery.session(
        session
      );
    }

    const claimedOrder =
      await claimQuery.exec();

    if (!claimedOrder) {
      return false;
    }

    for (const item of
      claimedOrder.items || []) {
      const productQuery =
        Product.findByIdAndUpdate(
          item.product,
          {
            $inc: {
              stock:
                item.quantity
            }
          },
          {
            new: true
          }
        );

      if (session) {
        productQuery.session(
          session
        );
      }

      const product =
        await productQuery.exec();

      if (!product) {
        throw new Error(
          `Product not found while restoring stock: ${
            item.name ||
            item.sku ||
            item.product
          }`
        );
      }
    }

    order.inventoryRestored =
      true;

    order.inventoryReservation =
      claimedOrder.inventoryReservation;

    return true;
  };

/*
|--------------------------------------------------------------------------
| EXPIRED RESERVATIONS
|--------------------------------------------------------------------------
*/

const releaseExpiredReservations =
  async (Order) => {
    if (!Order) {
      throw new Error(
        'Order model is required.'
      );
    }

    const now =
      new Date();

    const orders =
      await Order.find({
        'inventoryReservation.status':
          'Reserved',

        'inventoryReservation.expiresAt':
          {
            $lte: now
          }
      });

    let count = 0;

    for (const order of orders) {
      try {
        const released =
          await releaseReservation(
            order
          );

        if (!released) {
          continue;
        }

        /*
         * Re-read after atomic release.
         *
         * If payment won another race,
         * NEVER overwrite Paid.
         */
        const freshOrder =
          await Order.findById(
            order._id
          );

        if (!freshOrder) {
          continue;
        }

        if (
          freshOrder.payment?.status ===
          'Paid'
        ) {
          continue;
        }

        freshOrder.status =
          'Payment Failed';

        freshOrder.payment =
          freshOrder.payment || {};

        freshOrder.payment.status =
          'Failed';

        freshOrder.payment.failureReason =
          'Payment window expired.';

        freshOrder.statusHistory =
          freshOrder.statusHistory || [];

        freshOrder.statusHistory.push({
          status:
            'Payment Failed',

          note:
            'Inventory reservation expired before payment.',

          changedBy:
            'system',

          changedAt:
            new Date()
        });

        await freshOrder.save();

        count++;
      } catch (error) {
        console.error(
          `Failed to release expired reservation for ${order.orderNumber}:`,
          error.message
        );
      }
    }

    return count;
  };

module.exports = {
  reserveStock,
  releaseReservation,
  consumeReservation,
  restoreOrderStock,
  releaseExpiredReservations,
  restoreReservedItems
};
</file>

<file path="backend/services/pricingService.js">
const Currency =
  require('../models/Currency');

const PricingRule =
  require('../models/PricingRule');

const roundMoney = (
  value,
  decimals = 2
) => {
  const factor =
    Math.pow(10, decimals);

  return (
    Math.round(
      (Number(value) + Number.EPSILON) *
        factor
    ) / factor
  );
};

const getCurrency =
  async (currencyCode) => {
    const code =
      String(
        currencyCode || 'INR'
      )
        .trim()
        .toUpperCase();

    return Currency.findOne({
      code,
      isActive: true
    }).lean();
  };

const applyRule = (
  price,
  rule
) => {
  let result =
    Number(price);

  if (
    rule.method ===
    'percentage'
  ) {
    result =
      result +
      (
        result *
        Number(rule.value)
      ) /
        100;
  }

  if (
    rule.method ===
    'fixed'
  ) {
    result =
      result +
      Number(rule.value);
  }

  if (
    rule.method ===
    'multiplier'
  ) {
    result =
      result *
      Number(rule.value);
  }

  return result;
};

const getProductCurrencyConfig =
  (product, currency) => {
    const requested =
      String(currency || '')
        .trim()
        .toUpperCase();

    /*
     * Current schema: product.currencyPricing is a Map/object keyed by
     * currency code. This is what AdminPage sends and what Product.js stores.
     */
    let topLevel =
      product?.currencyPricing;

    if (topLevel instanceof Map) {
      topLevel = Object.fromEntries(
        topLevel.entries()
      );
    }

    if (topLevel && typeof topLevel === 'object') {
      const direct =
        topLevel[requested];

      if (direct) {
        return {
          ...direct,
          currency: requested,
          overridePrice:
            direct.overridePrice ??
            direct.price ??
            null
        };
      }
    }

    /*
     * Backward-compatible schema: pricing.currencyPricing as an array.
     */
    const nested =
      product?.pricing
        ?.currencyPricing;

    if (Array.isArray(nested)) {
      return (
        nested.find(
          (item) =>
            String(item?.currency || '')
              .trim()
              .toUpperCase() ===
            requested
        ) || null
      );
    }

    return null;
  };

const getProductPrice =
  async ({
    product,
    currency = 'INR',
    quantity = 1
  }) => {
    const requestedCurrency =
      String(currency)
        .trim()
        .toUpperCase();

    const qty =
      Math.max(
        1,
        Number(quantity) || 1
      );

    const baseCurrency =
      String(
        product.baseCurrency ||
          'INR'
      )
        .trim()
        .toUpperCase();

    const basePrice =
      Number(product.price) || 0;

    /*
     * ======================================================
     * BASE CURRENCY
     * ======================================================
     */

    if (
      requestedCurrency ===
      baseCurrency
    ) {
      const config =
        getProductCurrencyConfig(
          product,
          requestedCurrency
        );

      /*
       * Base currency override.
       */
      if (
        config &&
        config.enabled !== false &&
        config.mode ===
          'override' &&
        Number.isFinite(
          Number(
            config.overridePrice
          )
        )
      ) {
        return {
          currency:
            requestedCurrency,

          amount:
            roundMoney(
              config.overridePrice
            ),

          baseAmount:
            basePrice,

          rateFromBase: 1,

          source:
            'base-currency-override'
        };
      }

      /*
       * Base currency multiplier.
       *
       * FX = 1 for base currency.
       */
      if (
        config &&
        config.enabled !== false &&
        config.mode ===
          'multiplier'
      ) {
        return {
          currency:
            requestedCurrency,

          amount:
            roundMoney(
              basePrice *
                (
                  Number(
                    config.multiplier
                  ) || 1
                )
            ),

          baseAmount:
            basePrice,

          rateFromBase: 1,

          source:
            'base-currency-multiplier'
        };
      }

      return {
        currency:
          requestedCurrency,

        amount:
          roundMoney(
            basePrice
          ),

        baseAmount:
          basePrice,

        rateFromBase: 1,

        source:
          'base-price'
      };
    }

    /*
     * ======================================================
     * LEGACY CURRENCY OVERRIDE
     * ======================================================
     */

    if (
      product.currencyPrices &&
      typeof product.currencyPrices.get ===
        'function'
    ) {
      const directPrice =
        product.currencyPrices.get(
          requestedCurrency
        );

      if (
        directPrice !==
          undefined &&
        directPrice !== null &&
        Number.isFinite(
          Number(directPrice)
        )
      ) {
        return {
          currency:
            requestedCurrency,

          amount:
            roundMoney(
              directPrice
            ),

          baseAmount:
            basePrice,

          source:
            'product-currency-price'
        };
      }
    }

    /*
     * ======================================================
     * QUANTITY PRICING
     * ======================================================
     */

    if (
      product.pricing
        ?.allowQuantityPricing &&
      Array.isArray(
        product.pricing
          ?.quantityTiers
      )
    ) {
      const tier =
        product.pricing.quantityTiers.find(
          (item) => {
            const min =
              Number(
                item.minQuantity
              ) || 1;

            const max =
              item.maxQuantity ===
                null ||
              item.maxQuantity ===
                undefined
                ? Infinity
                : Number(
                    item.maxQuantity
                  );

            return (
              qty >= min &&
              qty <= max &&
              String(
                item.currency ||
                  baseCurrency
              )
                .trim()
                .toUpperCase() ===
                requestedCurrency
            );
          }
        );

      if (tier) {
        return {
          currency:
            requestedCurrency,

          amount:
            roundMoney(
              Number(
                tier.price
              ) || 0
            ),

          baseAmount:
            basePrice,

          source:
            'quantity-tier'
        };
      }
    }

    /*
     * ======================================================
     * CURRENCY CONFIG
     * ======================================================
     */

    const currencyConfig =
      await getCurrency(
        requestedCurrency
      );

    if (!currencyConfig) {
      throw new Error(
        `Currency ${requestedCurrency} is not configured.`
      );
    }

    const rate =
      Number(
        currencyConfig.rateFromBase
      );

    if (
      !Number.isFinite(rate) ||
      rate <= 0
    ) {
      throw new Error(
        `Invalid FX rate configured for ${requestedCurrency}.`
      );
    }

    /*
     * ======================================================
     * PRODUCT CURRENCY STRATEGY
     * ======================================================
     */

    const config =
      getProductCurrencyConfig(
        product,
        requestedCurrency
      );

    let finalPrice =
      basePrice * rate;

    let source =
      'currency-conversion';

    if (
      config &&
      config.enabled !== false
    ) {
      /*
       * AUTO
       *
       * Base Price × FX Rate
       */
      if (
        config.mode ===
        'auto'
      ) {
        finalPrice =
          basePrice * rate;

        source =
          'auto-fx';
      }

      /*
       * MULTIPLIER
       *
       * Base Price × FX Rate × multiplier
       */
      else if (
        config.mode ===
        'multiplier'
      ) {
        const multiplier =
          Number(
            config.multiplier
          );

        finalPrice =
          basePrice *
          rate *
          (
            Number.isFinite(
              multiplier
            )
              ? multiplier
              : 1
          );

        source =
          'fx-multiplier';
      }

      /*
       * EXACT OVERRIDE
       */
      else if (
        config.mode ===
        'override'
      ) {
        const override =
          Number(
            config.overridePrice
          );

        if (
          Number.isFinite(
            override
          ) &&
          override >= 0
        ) {
          finalPrice =
            override;

          source =
            'exact-override';
        }
      }
    }

    /*
     * ======================================================
     * GLOBAL / CATEGORY / PRODUCT RULES
     * ======================================================
     */

    const rules =
      await PricingRule.find({
        isActive: true,

        $or: [
          {
            scope: 'global'
          },

          {
            scope: 'category',
            category:
              product.categoryId
          },

          {
            scope: 'subcategory',
            category:
              product.subcategoryId
          },

          {
            scope: 'product',
            product:
              product._id
          }
        ],

        $and: [
          {
            $or: [
              {
                currency:
                  requestedCurrency
              },

              {
                currency:
                  null
              }
            ]
          },

          {
            $or: [
              {
                minQuantity: {
                  $lte: qty
                }
              },

              {
                minQuantity:
                  null
              }
            ]
          }
        ]
      })
        .sort({
          priority: -1
        })
        .lean();

    for (
      const rule of rules
    ) {
      if (
        rule.startsAt &&
        new Date() <
          new Date(
            rule.startsAt
          )
      ) {
        continue;
      }

      if (
        rule.endsAt &&
        new Date() >
          new Date(
            rule.endsAt
          )
      ) {
        continue;
      }

      if (
        rule.maxQuantity !==
          null &&
        rule.maxQuantity !==
          undefined &&
        qty >
          Number(
            rule.maxQuantity
          )
      ) {
        continue;
      }

      finalPrice =
        applyRule(
          finalPrice,
          rule
        );
    }

    return {
      currency:
        requestedCurrency,

      amount:
        roundMoney(
          finalPrice,
          currencyConfig.decimalPlaces
        ),

      baseAmount:
        basePrice,

      rateFromBase:
        rate,

      source
    };
  };

const getProductPricing =
  async ({
    product,
    currencies = []
  }) => {
    let requestedCurrencies =
      currencies;

    if (
      !Array.isArray(
        requestedCurrencies
      ) ||
      requestedCurrencies.length ===
        0
    ) {
      const active =
        await Currency.find({
          isActive: true
        })
          .sort({
            code: 1
          })
          .lean();

      requestedCurrencies =
        active.map(
          (item) =>
            item.code
        );
    }

    const result = {};

    for (
      const currency of
        requestedCurrencies
    ) {
      const code =
        String(currency)
          .trim()
          .toUpperCase();

      result[code] =
        await getProductPrice({
          product,
          currency: code
        });
    }

    return result;
  };

module.exports = {
  roundMoney,
  getCurrency,
  getProductPrice,
  getProductPricing
};
</file>

<file path="backend/utils/pricing.js">
/**
 * -----------------------------------------------------------------------
 * SHARED CURRENCY PRICING RESOLVER
 * -----------------------------------------------------------------------
 *
 * Formula:
 *   auto        => basePrice * currency.rateFromBase
 *   multiplier  => basePrice * currency.rateFromBase * config.multiplier
 *   override    => config.overridePrice   (exact, ignores FX rate)
 */

const roundToDecimals = (value, decimals = 2) => {
  const factor = Math.pow(10, decimals);
  return Math.round((Number(value) + Number.EPSILON) * factor) / factor;
};

function computeCurrencyPrices(product, currencies) {
  const basePrice = Number(product.price) || 0;
  const baseCurrency = String(product.baseCurrency || 'INR').toUpperCase();

  const currencyPricing =
    product.currencyPricing instanceof Map
      ? Object.fromEntries(product.currencyPricing)
      : product.currencyPricing || {};

  const result = [];

  for (const currency of currencies) {
    if (!currency || currency.isActive === false) continue;

    const code = String(currency.code).toUpperCase();
    const decimals = Number.isFinite(currency.decimalPlaces)
      ? currency.decimalPlaces
      : 2;

    if (code === baseCurrency) {
      result.push({
        currency: code,
        price: roundToDecimals(basePrice, decimals),
        enabled: true,
        source: 'base'
      });
      continue;
    }

    let config = currencyPricing[code];
    if (config && typeof config.toObject === 'function') {
      config = config.toObject();
    }

    if (!config || config.enabled === false) continue;

    const rate = Number(currency.rateFromBase);
    const mode = config.mode || 'auto';

    let finalPrice = null;

    if (mode === 'override') {
      const override = Number(config.overridePrice);
      if (Number.isFinite(override) && override >= 0) {
        finalPrice = override;
      }
    } else if (mode === 'multiplier') {
      const multiplier = Number.isFinite(Number(config.multiplier))
        ? Number(config.multiplier)
        : 1;
      if (Number.isFinite(rate) && rate > 0) {
        finalPrice = basePrice * rate * multiplier;
      }
    } else {
      if (Number.isFinite(rate) && rate > 0) {
        finalPrice = basePrice * rate;
      }
    }

    if (finalPrice === null || !Number.isFinite(finalPrice)) continue;

    result.push({
      currency: code,
      price: roundToDecimals(finalPrice, decimals),
      enabled: true,
      source: mode
    });
  }

  return result;
}

function resolveUnitPrice(product, currencyCode) {
  const code = String(currencyCode || product.baseCurrency || 'INR').toUpperCase();
  const baseCurrency = String(product.baseCurrency || 'INR').toUpperCase();

  if (code === baseCurrency) {
    const price = Number(product.price);
    if (!Number.isFinite(price) || price <= 0) {
      throw new Error(`"${product.name}" has no valid base price.`);
    }
    return { amount: price, currency: code };
  }

  const match = (product.prices || []).find(
    (p) => String(p.currency).toUpperCase() === code && p.enabled !== false
  );

  if (!match || !Number.isFinite(Number(match.price))) {
    throw new Error(
      `"${product.name}" is not available for purchase in ${code}.`
    );
  }

  return { amount: Number(match.price), currency: code };
}

module.exports = {
  computeCurrencyPrices,
  resolveUnitPrice,
  roundToDecimals
};
