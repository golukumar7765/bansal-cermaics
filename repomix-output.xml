                      currency.code === selectedCurrency
                        ? 'text-blue-600 bg-blue-50'
                        : 'text-slate-700'
                    }`}
                  >
                    {currency.name} ({currency.symbol}) -{' '}
                    {currency.code}
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>

        {error && (
          <div className="mb-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
            {error}
