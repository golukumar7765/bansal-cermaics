    }

    try {
      await api.delete(
        `${API_BASE_URL}/products/${id}`,
        getAuthConfig()
      );

      await fetchProducts();
    } catch (error) {
      alert(
        error.response?.data?.message ||
          error.message ||
          'Unable to delete product.'
